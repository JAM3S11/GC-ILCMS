# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URLS: Comma-separated list of the addresses this app is browsed on, in
# order of preference. Invitation and password-reset emails are built from the
# entry matching the Host of the request that triggered them, so whichever
# address an administrator is using is the one recipients get. Entries are an
# allowlist: only hosts named here can ever appear in an emailed link. List every
# address the server answers on - a stale entry sends staff to a dead link.
# In AI Studio this is injected with the Cloud Run service URL:
# APP_URLS="https://your-service-url"
APP_URLS="http://192.168.100.13:8000,http://192.168.200.157:8000"

# PostgreSQL account/auth database. Apply the schema with `npm run migrate`.
DATABASE_URL="postgresql://postgres://postgres@localhost:5432/gcilcms"
# Optional elevated connection string for one-time schema/bootstrap commands;
# keep this distinct from the restricted runtime database user in production.
MIGRATION_DATABASE_URL=""

# Initial super-admin setup. Used only by `npm run bootstrap:super-admin`;
# remove these values after creating the first administrator.
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# SMTP settings are required to send account activation links.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-gmail-account@gmail.com"
SMTP_PASSWORD="your-google-app-password"
MAIL_FROM="GC-ILCMS <your-gmail-account@gmail.com>"
